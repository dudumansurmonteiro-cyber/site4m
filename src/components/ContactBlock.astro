---
import { CONTATO } from '../lib/dados';

// Form só é publicado se o endpoint do provedor (Formspree/Web3Forms)
// estiver configurado — nunca publicar um form quebrado (seção 2).
const endpointForm = import.meta.env.PUBLIC_FORM_ENDPOINT as
  | string
  | undefined;
---

<div class="grid gap-16 lg:grid-cols-2">
  <div>
    <p class="eyebrow text-bronze">Telefone</p>
    <p class="mt-3">
      <a
        href={CONTATO.telefoneHref}
        class="titulo-display text-3xl numeros-tabulares transition-colors hover:text-bronze md:text-4xl"
      >
        {CONTATO.telefone}
      </a>
    </p>

    <p class="eyebrow mt-12 text-bronze">Endereço</p>
    <address class="mt-3 medida-texto text-lg leading-relaxed not-italic">
      {CONTATO.endereco}
    </address>

    <p class="mt-8">
      <a
        href="https://maps.google.com/?q=Av.+Pres.+Juscelino+Kubitschek,+1703,+S%C3%A3o+Paulo,+SP"
        rel="noopener noreferrer"
        class="text-sm font-semibold tracking-wide text-tinta transition-colors hover:text-bronze"
      >
        Ver no mapa <span aria-hidden="true">→</span>
      </a>
    </p>
  </div>

  {
    endpointForm && (
      <form
        action={endpointForm}
        method="POST"
        class="grid gap-6"
        aria-label="Formulário de contato"
      >
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="nome" class="text-sm font-medium">
              Nome
            </label>
            <input
              type="text"
              id="nome"
              name="nome"
              required
              autocomplete="name"
              class="mt-2 w-full border border-aco/40 bg-branco px-4 py-3 text-base focus:border-bronze"
            />
          </div>
          <div>
            <label for="email" class="text-sm font-medium">
              E-mail
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="mt-2 w-full border border-aco/40 bg-branco px-4 py-3 text-base focus:border-bronze"
            />
          </div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="telefone" class="text-sm font-medium">
              Telefone
            </label>
            <input
              type="tel"
              id="telefone"
              name="telefone"
              autocomplete="tel"
              class="mt-2 w-full border border-aco/40 bg-branco px-4 py-3 text-base numeros-tabulares focus:border-bronze"
            />
          </div>
          <div>
            <label for="assunto" class="text-sm font-medium">
              Assunto
            </label>
            <input
              type="text"
              id="assunto"
              name="assunto"
              required
              class="mt-2 w-full border border-aco/40 bg-branco px-4 py-3 text-base focus:border-bronze"
            />
          </div>
        </div>
        <div>
          <label for="mensagem" class="text-sm font-medium">
            Mensagem
          </label>
          <textarea
            id="mensagem"
            name="mensagem"
            rows={6}
            required
            class="mt-2 w-full border border-aco/40 bg-branco px-4 py-3 text-base focus:border-bronze"
          />
        </div>
        <div>
          <button
            type="submit"
            class="bg-grafite px-8 py-4 text-sm font-semibold tracking-wide text-branco transition-colors hover:bg-bronze"
          >
            Enviar mensagem
          </button>
        </div>
      </form>
    )
  }
</div>
