---
/**
 * Footer (CLAUDE.md, seções 4.1 e 8): grafite, logo, contato completo,
 * links do menu, copyright. Sem crédito de agência.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo-grupo4m.png';
import { MENU, NOME, TAGLINE, TELEFONE, ENDERECO } from '../data/site';

const ano = new Date().getFullYear();
---

<footer class="bg-grafite text-branco">
  <div class="container-site pt-16 pb-10 md:pt-24">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="inline-block" aria-label={`${NOME} — página inicial`}>
          <Image src={logo} alt={NOME} height={26} densities={[1, 2]} class="h-[26px] w-auto" />
        </a>
        <p class="mt-4 max-w-[36ch] text-14 text-aco-claro">{TAGLINE}</p>
      </div>

      <nav aria-label="Links do rodapé" class="md:col-span-3">
        <ul class="flex flex-col gap-3">
          {
            MENU.map((item) => (
              <li>
                <a href={item.href} class="text-14 text-branco/85 transition-colors hover:text-bronze">
                  {item.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="md:col-span-4">
        <p class="eyebrow text-aco-claro">Telefone</p>
        <a href={TELEFONE.href} class="tnum mt-2 inline-block text-18 text-branco transition-colors hover:text-bronze">
          {TELEFONE.display}
        </a>

        <p class="eyebrow mt-8 text-aco-claro">Endereço</p>
        <p class="mt-2 text-14 leading-relaxed text-branco/85">
          {ENDERECO.linha1}
          <br />
          {ENDERECO.linha2}
        </p>
      </div>
    </div>

    <div class="mt-16 border-t border-linha-escura pt-6">
      <p class="text-14 text-aco-claro">© {NOME} {ano}</p>
    </div>
  </div>
</footer>
