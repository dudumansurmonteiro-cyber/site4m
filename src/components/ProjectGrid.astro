---
/**
 * ProjectGrid (CLAUDE.md, seção 8): agrupa ProjectCards por categoria,
 * com subtítulos (Edifícios/Loteamentos/…) e âncoras para o breadcrumb.
 */
import type { CollectionEntry } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import { ANCORA_CATEGORIA } from '../data/setores';

interface Props {
  projetos: CollectionEntry<'projetos'>[];
  categorias: string[];
}

const { projetos, categorias } = Astro.props;

const grupos = categorias
  .map((categoria) => ({
    categoria,
    ancora: ANCORA_CATEGORIA[categoria] ?? categoria.toLowerCase(),
    itens: projetos
      .filter((p) => (p.data.categorias as readonly string[]).includes(categoria))
      .sort((a, b) => a.data.ordem - b.data.ordem),
  }))
  .filter((g) => g.itens.length > 0);
---

<div class="flex flex-col gap-20 md:gap-28">
  {
    grupos.map((grupo) => (
      <section id={grupo.ancora} aria-labelledby={`titulo-${grupo.ancora}`} class="scroll-mt-24">
        <div data-reveal>
          <span class="filete" aria-hidden="true" />
          <h2 id={`titulo-${grupo.ancora}`} class="titulo-display mt-6 text-28 md:text-36">
            {grupo.categoria}
          </h2>
        </div>
        <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
          {grupo.itens.map((projeto) => (
            <div data-reveal>
              <ProjectCard {projeto} categoria={grupo.categoria} />
            </div>
          ))}
        </div>
      </section>
    ))
  }
</div>
