---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import homeHero from '../assets/home-hero.jpg';
import logo from '../assets/logo-grupo4m.png';
import { CONTATO } from '../lib/dados';
import { comBase } from '../lib/util';

interface Props {
  /** Título completo da aba (padrão da seção 9 já aplicado por quem chama). */
  titulo: string;
  descricao: string;
  /** Imagem OG específica (projetos usam a imagem do projeto). */
  imagemOg?: ImageMetadata;
  /** JSON-LD Organization — apenas na home. */
  organizacao?: boolean;
}

const { titulo, descricao, imagemOg, organizacao = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({
  src: imagemOg ?? homeHero,
  width: 1200,
  height: 630,
  format: 'jpeg',
});
const ogUrl = new URL(og.src, Astro.site);

const jsonLdOrganizacao = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Grupo 4M',
  url: Astro.site?.toString(),
  logo: new URL(logo.src, Astro.site).toString(),
  telephone: CONTATO.telefoneJsonLd,
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTATO.enderecoPostal.logradouro,
    addressLocality: CONTATO.enderecoPostal.cidade,
    addressRegion: CONTATO.enderecoPostal.uf,
    addressCountry: CONTATO.enderecoPostal.pais,
  },
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{titulo}</title>
<meta name="description" content={descricao} />
<link rel="canonical" href={canonical} />
<link
  rel="icon"
  type="image/png"
  sizes="32x32"
  href={comBase('/favicon-32.png')}
/>
<link rel="apple-touch-icon" href={comBase('/apple-touch-icon.png')} />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Grupo 4M" />
<meta property="og:locale" content="pt_BR" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descricao} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descricao} />
<meta name="twitter:image" content={ogUrl} />

{
  organizacao && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLdOrganizacao)}
    />
  )
}
