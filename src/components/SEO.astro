---
/**
 * Componente central de <head> (CLAUDE.md, seções 8 e 9):
 * title, description, canonical, OG/Twitter e JSON-LD Organization (home).
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { NOME, URL_SITE, TELEFONE } from '../data/site';
import ogPadrao from '../assets/home-hero.jpg';
import logo from '../assets/logo-grupo4m.png';

interface Props {
  titulo: string;
  descricao: string;
  /** Imagem OG específica da página (padrão: home-hero.jpg). */
  ogImagem?: ImageMetadata;
  /** Emite o JSON-LD Organization — usar apenas na home. */
  organizacao?: boolean;
  /** Impede indexação (página 404). */
  noindex?: boolean;
}

const {
  titulo,
  descricao,
  ogImagem = ogPadrao,
  organizacao = false,
  noindex = false,
} = Astro.props;

// Canonical com barra final, no domínio oficial (preserva os slugs atuais)
const caminho = Astro.url.pathname.endsWith('/')
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonical = new URL(caminho, URL_SITE).href;

const og = await getImage({
  src: ogImagem,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpg',
});
const ogUrl = new URL(og.src, URL_SITE).href;

const jsonLd = organizacao
  ? JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: NOME,
      url: `${URL_SITE}/`,
      logo: new URL(logo.src, URL_SITE).href,
      telephone: TELEFONE.e164,
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Av. Pres. Juscelino Kubitschek, 1703, 1º Andar, Vila Nova Conceição',
        addressLocality: 'São Paulo',
        addressRegion: 'SP',
        addressCountry: 'BR',
      },
    })
  : null;
---

<title>{titulo}</title>
<meta name="description" content={descricao} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={NOME} />
<meta property="og:locale" content="pt_BR" />
<meta property="og:title" content={titulo} />
<meta property="og:description" content={descricao} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titulo} />
<meta name="twitter:description" content={descricao} />
<meta name="twitter:image" content={ogUrl} />

{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
