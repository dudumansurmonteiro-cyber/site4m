---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  indice: string;
  nome: string;
  texto: string;
  href: string;
  imagem: ImageMetadata;
  alt: string;
}

const { indice, nome, texto, href, imagem, alt } = Astro.props;
---

<article class="group relative" data-revelar>
  <div class="overflow-hidden">
    <Image
      src={imagem}
      alt={alt}
      widths={[480, 768, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      class="aspect-[4/3] w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-6 flex items-baseline gap-4">
    <span class="text-sm font-semibold text-bronze numeros-tabulares" aria-hidden="true">
      {indice}
    </span>
    <h3 class="titulo-display text-2xl transition-colors group-hover:text-bronze">
      <a href={href} class="after:absolute after:inset-0">{nome}</a>
    </h3>
  </div>
  <p class="mt-3 medida-texto text-base text-aco">{texto}</p>
  <p class="mt-4 text-sm font-semibold tracking-wide text-tinta transition-colors group-hover:text-bronze">
    Conheça <span aria-hidden="true">→</span>
  </p>
</article>
