---
/**
 * SectorCard (CLAUDE.md, seção 8): índice 01–04 em bronze, imagem,
 * título, texto e "Conheça". Usado na malha 2×2 da home.
 */
import { Image } from 'astro:assets';
import type { Setor } from '../data/setores';

interface Props {
  setor: Setor;
}

const { setor } = Astro.props;
---

<article class="group">
  <a href={setor.href} class="block">
    {
      setor.imagemCardModo === 'conter' ? (
        <div class="flex aspect-[3/2] w-full items-center justify-center border border-linha bg-branco p-12">
          <Image
            src={setor.imagemCard}
            alt={setor.altCard}
            class="max-h-full w-auto max-w-full object-contain"
          />
        </div>
      ) : (
        <div class="overflow-hidden bg-grafite">
          <Image
            src={setor.imagemCard}
            alt={setor.altCard}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 768px) 46vw, 92vw"
            class="aspect-[3/2] w-full object-cover motion-safe:transition-transform motion-safe:duration-700 motion-safe:group-hover:scale-[1.03]"
          />
        </div>
      )
    }
    <div class="mt-6 flex gap-5">
      <span class="tnum pt-[6px] text-14 font-medium text-bronze-escuro">{setor.indice}</span>
      <div>
        <h2 class="titulo-display text-28 transition-colors group-hover:text-bronze-escuro md:text-36">
          {setor.nome}
        </h2>
        <p class="mt-3 max-w-[58ch] text-16 text-aco-escuro">{setor.textoHome}</p>
        <span class="eyebrow mt-5 inline-block border-b-2 border-bronze pb-1 text-tinta">
          Conheça
        </span>
      </div>
    </div>
  </a>
</article>
