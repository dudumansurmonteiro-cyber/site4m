---
/**
 * ValueItem (CLAUDE.md, seção 8): título + texto — usado em
 * "Nossos valores" e blocos equivalentes.
 */
interface Props {
  titulo: string;
  texto: string;
}

const { titulo, texto } = Astro.props;
---

<div class="border-t border-linha pt-6">
  <h3 class="text-18 font-semibold">{titulo}</h3>
  <p class="mt-3 max-w-[62ch] text-16 text-aco-escuro">{texto}</p>
</div>
