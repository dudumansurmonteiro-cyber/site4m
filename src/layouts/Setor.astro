---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Hero from '../components/Hero.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { setorPorSlug } from '../lib/dados';
import { imagemProjeto } from '../lib/imagens';

interface Props {
  slug: 'imobiliario' | 'energia' | 'educacao' | 'financeiro';
  descricao: string;
  heroImagem?: ImageMetadata;
  heroAlt?: string;
}

const { slug, descricao, heroImagem, heroAlt } = Astro.props;
const setor = setorPorSlug(slug);

const projetos = await getCollection(
  'projetos',
  (p) => p.data.setor === slug
);

// Setores com um único destaque (Educação/Financeiro) ganham layout de
// destaque em vez de grade (seções 4.5 e 4.6).
const destaqueUnico = projetos.length === 1 ? projetos[0] : null;
---

<Base titulo={setor.nome} descricao={descricao}>
  <Hero
    eyebrow={`${setor.indice} — Setor`}
    imagem={heroImagem}
    alt={heroAlt ?? ''}
  >
    {setor.nome}
    <Fragment slot="texto">
      <slot name="intro" />
    </Fragment>
  </Hero>

  <section class="section-pad" aria-label={`Projetos do setor ${setor.nome}`}>
    <div class="container-site">
      {
        destaqueUnico ? (
          <article class="group relative grid items-center gap-10 lg:grid-cols-2" data-revelar>
            <div class="overflow-hidden">
              <Image
                src={imagemProjeto(destaqueUnico.data.imagem)}
                alt={
                  destaqueUnico.data.tipo
                    ? `${destaqueUnico.data.titulo} — ${destaqueUnico.data.tipo}`
                    : destaqueUnico.data.titulo
                }
                widths={[640, 960, 1400]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                class="aspect-[4/3] w-full object-cover transition-transform duration-500 motion-safe:group-hover:scale-[1.03]"
              />
            </div>
            <div>
              <p class="eyebrow text-aco">{destaqueUnico.data.categoria}</p>
              <h2 class="titulo-display mt-4 text-3xl transition-colors group-hover:text-bronze md:text-4xl">
                <a
                  href={`/${destaqueUnico.data.slug}/`}
                  class="after:absolute after:inset-0"
                >
                  {destaqueUnico.data.titulo}
                </a>
              </h2>
              <p class="mt-6 text-sm font-semibold tracking-wide text-tinta transition-colors group-hover:text-bronze">
                Conheça <span aria-hidden="true">→</span>
              </p>
            </div>
          </article>
        ) : (
          <ProjectGrid projetos={projetos} categorias={setor.categorias} />
        )
      }
    </div>
  </section>
</Base>
