---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import StatBlock from '../components/StatBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { setorPorSlug } from '../lib/dados';
import { imagemProjeto } from '../lib/imagens';
import { comBase, slugificar } from '../lib/util';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({
    params: { slug: projeto.data.slug },
    props: { projeto },
  }));
}

const { projeto } = Astro.props;
const dados = projeto.data;
const setor = setorPorSlug(dados.setor);
const imagem = imagemProjeto(dados.imagem);
const alt = dados.tipo ? `${dados.titulo} — ${dados.tipo}` : dados.titulo;

// Meta description gerada a partir de tipo + setor (seção 9)
const descricao = dados.tipo
  ? `${dados.titulo}: ${dados.tipo.toLowerCase()} do Grupo 4M no setor ${setor.nome}.`
  : `${dados.titulo} — projeto do Grupo 4M no setor ${setor.nome}.`;

// "Outros projetos": 2–3 cards do mesmo setor (seção 4.9)
const outros = (
  await getCollection(
    'projetos',
    (p) => p.data.setor === dados.setor && p.data.slug !== dados.slug
  )
)
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .slice(0, 3);
---

<Base titulo={dados.titulo} descricao={descricao} imagemOg={imagem}>
  <section class="bg-grafite text-branco">
    <div class="container-site pt-10 pb-14 md:pt-14 md:pb-20">
      <nav aria-label="Trilha de navegação">
        <ol class="flex flex-wrap items-center gap-2 text-sm text-pedra/70">
          <li>
            <a
              href={comBase(`/${setor.slug}/`)}
              class="transition-colors hover:text-bronze">{setor.nome}</a
            >
          </li>
          <li aria-hidden="true" class="text-aco">/</li>
          <li>
            <a
              href={comBase(
                `/${setor.slug}/#categoria-${slugificar(dados.categoria)}`
              )}
              class="transition-colors hover:text-bronze">{dados.categoria}</a
            >
          </li>
          <li aria-hidden="true" class="text-aco">/</li>
          <li aria-current="page" class="text-branco">{dados.titulo}</li>
        </ol>
      </nav>

      {
        dados.tipo && (
          <p class="hero-entrada eyebrow mt-10 text-bronze">{dados.tipo}</p>
        )
      }
      <h1
        class:list={[
          'hero-entrada titulo-display max-w-4xl text-4xl md:text-5xl',
          dados.tipo ? 'mt-4' : 'mt-10',
        ]}
      >
        {dados.titulo}
      </h1>
    </div>
    <div class="hero-entrada">
      <Image
        src={imagem}
        alt={alt}
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="h-[46vh] w-full object-cover md:h-[62vh]"
      />
    </div>
  </section>

  {
    (dados.stats.length > 0 || dados.descricao) && (
      <section class="section-pad" aria-label="Dados do projeto">
        <div class="container-site">
          {dados.descricao && (
            <p class="medida-texto text-lg text-tinta" data-revelar>
              {dados.descricao}
            </p>
          )}
          {dados.stats.length > 0 && (
            <dl
              class:list={[
                'grid gap-10 sm:grid-cols-2 lg:grid-cols-3',
                dados.descricao && 'mt-16',
              ]}
              data-revelar
            >
              {dados.stats.map((stat) => (
                <StatBlock label={stat.label} valor={stat.valor} />
              ))}
            </dl>
          )}
        </div>
      </section>
    )
  }

  {
    outros.length > 0 && (
      <section
        class:list={[
          'section-pad',
          (dados.stats.length > 0 || dados.descricao) && 'bg-pedra',
        ]}
        aria-labelledby="titulo-outros"
      >
        <div class="container-site">
          <div class="filete-bronze pt-5" data-revelar>
            <p class="eyebrow text-bronze">{setor.nome}</p>
            <h2 id="titulo-outros" class="titulo-display mt-4 text-3xl">
              Outros projetos
            </h2>
          </div>
          <div class="mt-12 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {outros.map((outro) => (
              <ProjectCard
                titulo={outro.data.titulo}
                categoria={outro.data.categoria}
                href={`/${outro.data.slug}/`}
                imagem={imagemProjeto(outro.data.imagem)}
                alt={
                  outro.data.tipo
                    ? `${outro.data.titulo} — ${outro.data.tipo}`
                    : outro.data.titulo
                }
              />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
