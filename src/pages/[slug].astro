---
/**
 * Página de projeto (CLAUDE.md, seção 4.9): slugs preservados na raiz,
 * breadcrumb Setor → Categoria → Projeto, imagem hero grande, tipo + stats
 * em numerais tabulares e "Outros projetos" do mesmo setor. O layout
 * funciona bem mesmo quando o projeto ainda não tem tipo/stats.
 */
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import StatBlock from '../components/StatBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SETOR_POR_ID, ANCORA_CATEGORIA } from '../data/setores';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos');
  return projetos.map((projeto) => ({
    params: { slug: projeto.data.slug },
    props: { projeto },
  }));
}

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

const { projeto } = Astro.props;
const dados = projeto.data;
const setor = SETOR_POR_ID[dados.setor];
const categoriaPrincipal = dados.categorias[0];

const { Content } = await render(projeto);
const temTexto = Boolean(projeto.body?.trim() || dados.descricao?.trim());
const temLink = Boolean(dados.linkExterno);

const outros = (await getCollection('projetos', ({ data }) => data.setor === dados.setor))
  .filter((p) => p.data.slug !== dados.slug)
  .sort((a, b) => a.data.ordem - b.data.ordem)
  .slice(0, 3);

const descricaoMeta = dados.tipo
  ? `${dados.titulo}: ${dados.tipo.toLowerCase()} do Grupo 4M no setor ${setor.nome}.`
  : `${dados.titulo} — projeto do Grupo 4M no setor ${setor.nome}.`;

// Fotos de origem pequena (ex.: renders enviados em baixa resolução) não devem
// esticar até 1920px de largura — preferimos um banner menor e nítido a um
// grande e borrado. Acima de 1200px de largura na origem, segue o full-bleed.
const larguraFonte = dados.imagem.width;
const ehCobrir = dados.imagemModo !== 'conter';
// Foto vertical pequena: o recorte largo do banner cortaria o prédio no meio,
// então ela aparece inteira, centralizada sobre o fundo grafite.
const retratoPequeno = ehCobrir && dados.imagem.height > larguraFonte && larguraFonte < 1200;
const fotoPequena = ehCobrir && !retratoPequeno && larguraFonte < 1200;
const larguraMaxHero = fotoPequena ? Math.round(larguraFonte * 1.4) : null;
---

<Base titulo={`${dados.titulo} | Grupo 4M`} descricao={descricaoMeta} ogImagem={dados.imagem}>
  <!-- Cabeçalho do projeto -->
  <section class="bg-grafite text-branco">
    <div class="container-site hero-anim pt-16 pb-14 md:pt-24 md:pb-20">
      <Breadcrumb
        itens={[
          { rotulo: setor.nome, href: setor.href },
          {
            rotulo: categoriaPrincipal,
            href: `${setor.href}#${ANCORA_CATEGORIA[categoriaPrincipal] ?? ''}`,
          },
          { rotulo: dados.titulo },
        ]}
      />
      <h1 class="titulo-display mt-8 max-w-[20ch] text-36 text-balance md:text-48 lg:text-64">
        {dados.titulo}
      </h1>
      {
        (dados.tipo || dados.localizacao) && (
          <p class="mt-5 text-18 text-aco-claro md:text-22">
            {[dados.tipo, dados.localizacao].filter(Boolean).join(' · ')}
          </p>
        )
      }
    </div>
  </section>

  <!-- Imagem hero (foto em tela cheia ou logomarca em painel) -->
  {
    dados.imagemModo === 'conter' ? (
      <div class="flex justify-center border-b border-linha bg-branco px-6 py-16 md:py-24">
        <Image
          src={dados.imagem}
          alt={dados.imagemAlt}
          loading="eager"
          class="h-auto max-h-[220px] w-auto max-w-full object-contain md:max-h-[300px]"
        />
      </div>
    ) : retratoPequeno ? (
      <div class="bg-grafite px-6 py-10 md:py-14">
        <Image
          src={dados.imagem}
          alt={dados.imagemAlt}
          widths={[larguraFonte]}
          sizes={`${larguraFonte}px`}
          loading="eager"
          fetchpriority="high"
          class="mx-auto h-auto max-h-[72svh] w-auto max-w-full"
        />
      </div>
    ) : (
      <div
        class="bg-grafite"
        style={larguraMaxHero ? `max-width: ${larguraMaxHero}px; margin-inline: auto;` : undefined}
      >
        <Image
          src={dados.imagem}
          alt={dados.imagemAlt}
          widths={fotoPequena ? [larguraFonte] : [768, 1280, 1600, 1920]}
          sizes={fotoPequena ? `${larguraMaxHero}px` : '100vw'}
          loading="eager"
          fetchpriority="high"
          class="aspect-[16/9] max-h-[78svh] w-full object-cover md:aspect-[21/10]"
        />
      </div>
    )
  }

  <!-- Dados do empreendimento -->
  {
    (dados.stats.length > 0 || temTexto || temLink) && (
      <section class="bg-branco">
        <div class="container-site py-20 md:py-28">
          <div class="grid gap-16 md:grid-cols-12">
            {(temTexto || temLink) && (
              <div class="md:col-span-6" data-reveal>
                {dados.descricao?.trim() && (
                  <p class="titulo-display text-22 md:text-28">{dados.descricao}</p>
                )}
                {projeto.body?.trim() && (
                  <div class="mt-6 max-w-[68ch] text-16 text-aco-escuro md:text-18 [&_p+p]:mt-4">
                    <Content />
                  </div>
                )}
                {temLink && (
                  <a
                    href={dados.linkExterno!.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class:list={[
                      temTexto ? 'mt-8' : '',
                      'eyebrow inline-block border-b-2 border-bronze pb-1 text-tinta transition-colors hover:text-bronze-escuro',
                    ]}
                  >
                    {dados.linkExterno!.label}
                  </a>
                )}
              </div>
            )}
            {dados.stats.length > 0 && (
              <div
                class:list={[temTexto ? 'md:col-span-6' : 'md:col-span-10 lg:col-span-8']}
                data-reveal
              >
                <StatBlock stats={dados.stats} />
              </div>
            )}
          </div>
        </div>
      </section>
    )
  }

  <!-- Outros projetos do setor -->
  {
    outros.length > 0 && (
      <section aria-labelledby="titulo-outros" class="bg-pedra">
        <div class="container-site py-20 md:py-28">
          <div data-reveal>
            <span class="filete" aria-hidden="true" />
            <h2 id="titulo-outros" class="titulo-display mt-6 text-28 md:text-36">
              Outros projetos
            </h2>
          </div>
          <div class="mt-10 grid gap-x-8 gap-y-14 sm:grid-cols-2 lg:grid-cols-3">
            {outros.map((outro) => (
              <div data-reveal>
                <ProjectCard projeto={outro} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>
